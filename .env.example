# API Base URL - Backend Gateway
VITE_API_BASE_URL=

# Optional Admin URL override. Default: localhost:5174 in dev, fptux-admin-ui.pages.dev in production.
VITE_ADMIN_APP_URL=
# CTSV SSO is enabled by default. Set false for an isolated UI fixture server.
VITE_STAFF_SSO_ENABLED=true

# Public R2 identifiers only. Do not put access keys in VITE_ variables.
VITE_R2_BUCKET_NAME=fptux-cloud-storage
VITE_R2_S3_ENDPOINT=https://c2e463013aa669515ae4e2c54843c4ae.r2.cloudflarestorage.com
VITE_R2_PUBLIC_BASE_URL=https://pub-3092f35e8d664b8caf203e269232769a.r2.dev

# Google Identity Services OAuth 2.0 Web client ID
VITE_GOOGLE_CLIENT_ID=

# Local-development only: skip the login gate with a local admin actor.
# VITE_DISABLE_AUTH=true

# Khi build bằng Docker, dùng reverse proxy cùng origin:
# VITE_API_BASE_URL=/api

# Optional development email shortcuts. Never autofills passwords.
VITE_LOGIN_ACCOUNT_SHORTCUTS=false
